# Build output — Vercel regenerates this from src/ on every deploy.
dist/

# Not used (the project has zero dependencies) but harmless to guard.
node_modules/

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/

# NOTE: src/assets/ is deliberately NOT ignored. The photographs and the menu
# PDF are inputs, not build artifacts — the build fails without them.

# Retired photos and the owner's uncropped phone originals. Kept on disk as a
# working archive; the build ignores this folder and the repo doesn't need
# 27 MB of PNG screenshots. Anything the site actually uses lives one level up.
src/assets/photos/unused/
